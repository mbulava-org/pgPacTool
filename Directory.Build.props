<Project>
  <!-- Common properties for all projects in the solution -->
  
  <!--
    Code coverage: use coverlet.collector (XPlat Code Coverage data collector) only.
    coverlet.msbuild was removed because it instruments assemblies on disk, then
    tries to restore the originals at process exit. When the native library
    libpg_query is still mapped into the test host at that point, the copy of
    Npgquery.dll fails with "file in use", crashing the host after all tests pass.
    coverlet.collector is an in-process data collector and never modifies DLLs on
    disk, so it is safe to use with projects that hold native library handles.
    Each test .csproj already carries its own coverlet.collector reference.
  -->
</Project>
